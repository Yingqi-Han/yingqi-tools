<Page x:Class="YingqiTools.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:YingqiTools.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="设置">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
    <Grid MaxWidth="820" Margin="0,28,0,40" HorizontalAlignment="Left">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="设置" />
        <TextBlock Style="{StaticResource PageDescription}" Text="这里只保存界面主题，不保存任何合盖状态或电源参数。" />
      </StackPanel>
      <ui:Card Grid.Row="1" Margin="0,28,0,0" Padding="24">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="应用主题" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,24,0" Text="默认跟随 Windows，也可以固定为浅色或深色。" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedTheme}" SelectedValuePath="Tag" AutomationProperties.Name="应用主题">
            <ComboBoxItem Content="跟随系统" Tag="{x:Static models:ThemePreference.System}" />
            <ComboBoxItem Content="浅色" Tag="{x:Static models:ThemePreference.Light}" />
            <ComboBoxItem Content="深色" Tag="{x:Static models:ThemePreference.Dark}" />
          </ComboBox>
        </Grid>
      </ui:Card>
      <ui:InfoBar Grid.Row="2" Margin="0,20,0,0" IsOpen="True" Severity="Informational" Title="隐私" Message="Yingqi Tools 不联网、不收集遥测，也不会设置开机自动启用。" />
    </Grid>
  </ScrollViewer>
</Page>
